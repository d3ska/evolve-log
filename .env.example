# ============================================================
# evolve-log — environment variables template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# --- Database ---
# JDBC URL for the PostgreSQL database (Docker Compose internal hostname)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/evolvelog

# PostgreSQL username
SPRING_DATASOURCE_USERNAME=evolvelog

# PostgreSQL password — pick a strong password for production
SPRING_DATASOURCE_PASSWORD=

# PostgreSQL root password (used by the postgres Docker image)
POSTGRES_PASSWORD=

# --- Spring profile ---
# Use "prod" on the server; leave as "local" for local dev
SPRING_PROFILES_ACTIVE=prod

# --- Frontend URL ---
# Public HTTPS URL of the app — used for OAuth redirect URIs and CORS
APP_FRONTEND_URL=https://yourdomain.com

# --- Google OAuth ---
# From https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Withings OAuth ---
# From https://developer.withings.com → My Applications
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# --- AI encryption key ---
# AES-256 key, must be exactly 32 bytes when Base64-decoded
# Generate with: openssl rand -base64 32
APP_AI_ENCRYPTION_KEY=

# ============================================================
# Fitatu automation (DEFERRED — not implemented yet)
# Uncomment and fill in when implementing the sync runner.
# Store these in /opt/evolve-log/.env.fitatu on the server,
# NOT in this file.
# ============================================================

# Fitatu account credentials (used by the Playwright sync runner)
# FITATU_EMAIL=
# FITATU_PASSWORD=

# Internal URL for the evolve-log backend (Docker network)
# EVOLVELOG_API_URL=http://backend:8080

# Shared secret for the import endpoint (X-Internal-Token header)
# EVOLVELOG_IMPORT_TOKEN=
